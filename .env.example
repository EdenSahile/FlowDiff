# Copie ce fichier en .env et remplis les valeurs.
#
# L'application est une démo front sur données mock : elle n'a pas de backend
# et ne lit aucune de ces variables au runtime. Elles ne servent qu'aux
# chantiers annexes listés ci-dessous.

# Couvertures : scripts/download-covers-from-manifest.mjs n'en a pas besoin,
# il lit le manifeste local scripts/covers-found.json.

# Aidénia, chantier reporté (voir parked/aidenia/README.md).
# Nécessaires uniquement pour relancer les scripts Python d'indexation.
OPENAI_API_KEY="clé OpenAI"
PINECONE_API_KEY="clé Pinecone"
PINECONE_INDEX="nom de l'index Pinecone"
ANTHROPIC_API_KEY="clé Anthropic"

# Formulaire de feedback (api/feedback.ts), envoi d'email via Gmail.
GMAIL_USER="adresse@gmail.com"
GMAIL_APP_PASSWORD="mot de passe d'application Gmail"
FEEDBACK_TO="destinataire@exemple.fr"
